def zip_extractor(date):
    # API платное, страницу защищают от request. Работает только ручное скачивание с https://boardgamegeek.com/data_dumps/bg_ranks
    try:
        with ZipFile(fr'C:\Users\User\Downloads\boardgames_ranks_{date}.zip', 'r') as zip:
            cur_name = zip.namelist()[0]
            new_name = zip.namelist()[0][:-5] + '_' + date + '.csv'
            zip.extractall(path=path)
            os.rename(path+'/'+cur_name, path+'/'+new_name)
        print(f'Новый файл {new_name} создан')
    except FileExistsError as e:
        print(f'Файл {new_name} уже был создан ранее')
    except FileNotFoundError as e:
        print('Файла zip нет')

def delimiter(name, legit_names, legit_names_2):
    # самый частый разделитель :, его в приоритет. Если не нашлось, то различные виды тире и !
    for sign in [':', ' -', '!', ' –']:
        if sign in name and name.split(sign)[0].strip() in legit_names:
            return name.split(sign)[0]
    if re.search(r' \d', name)  and re.split(r' \d', name)[0].strip() in legit_names:
        return re.split(r' \d', name)[0]
    # работает вторая линия обороны для игр типа main_title: blah-blah-blah
    if ':' in name and name.split(':')[0].strip() in legit_names_2:
        return legit_names_2[name.split(':')[0].strip()]


